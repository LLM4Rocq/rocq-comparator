# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A trustworthy judge for Rocq proofs"
description:
  "Checks that a solution file proves the same statements as a trusted challenge file, using no more axioms than permitted, with the proof accepted by the Rocq kernel. Kernel-level comparison in-process (linked against rocq-runtime), modelled on leanprover/comparator."
maintainer: ["guillaume.baudart@gmail.com"]
authors: ["LLM4Rocq"]
license: "Apache-2.0"
homepage: "https://github.com/LLM4Rocq/rocq-comparator"
bug-reports: "https://github.com/LLM4Rocq/rocq-comparator/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.8"}
  "rocq-runtime" {>= "9.2"}
  "rocq-core"
  "rocq-stdlib"
  "yojson"
  "cmdliner"
  "memprof-limits"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LLM4Rocq/rocq-comparator.git"
